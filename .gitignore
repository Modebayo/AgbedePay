# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Database backups (dumps)
*.sql.gz
*.dump
*.sql
# ...but schema migrations are source code and MUST be version-controlled.
!backend/src/database/migrations/*.sql

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/

# Build / deployment
dist/
build/
coverage/

# Temporary files
tmp/
temp/

# Local test data
ada.cookies.txt
chidi.cookies.txt
termii-test.json

# User-uploaded files (profile pictures). Personal data — never committed.
# No leading slash: in .gitignore that anchors the pattern to the repo root
# instead of matching at any depth. The directory is created at runtime.
backend/storage/
