# Server
NODE_ENV=development
PORT=3000

# Public base URL of this deployment. Used to build provider callback and
# webhook URLs. Defaults to http://localhost:PORT when unset.
APP_BASE_URL=http://localhost:3000

# Session lifetime in milliseconds. Defaults to 604800000 (7 days) when unset.
SESSION_TTL_MS=604800000

# PostgreSQL — local Windows installs often trust 127.0.0.1 connections.
# If yours needs a password: postgres://postgres:YOUR_PASSWORD@localhost:5432/agbedepay
DATABASE_URL=postgres://postgres@localhost:5432/agbedepay

# OTP delivery provider: "mock" (prints the code to the server console) or
# "termii" (sends a real SMS). Defaults to "mock" when unset.
SMS_PROVIDER=termii

# Termii (https://termii.com) — only needed when SMS_PROVIDER=termii.
# Get your API key from Settings -> API token. Sender ID must be an approved
# alphanumeric sender ID (or your "Generic"/DND sender) on your account.
# Base URL is your per-account dashboard URL (v4 accounts use https://v4.api.termii.com).
TERMII_API_KEY=YOUR_TERMII_API_KEY
TERMII_SENDER_ID=YOUR_TERMII_SENDER_ID
TERMII_BASE_URL=https://v4.api.termii.com

# ---- Google Maps / Routes ----
# When BOTH keys are absent the app falls back to a deterministic mock route,
# so it runs with no key. Add them to switch on live maps + real distances.
# Browser key is served to the frontend: restrict it by HTTP referrer.
# Server key stays on the backend: restrict it by IP; enable "Routes API".
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_REGION=NG

# Default platform commission in basis points applied to completed trips when
# neither the driver profile nor the pricing rule specifies one. 1500 = 15%.
PLATFORM_COMMISSION_BP=1500

# ---- Paystack (use TEST keys until go-live) ----
# Dashboard -> Settings -> API Keys & Webhooks. The webhook uses the same
# secret key to verify the x-paystack-signature header.
# Set the webhook URL in the dashboard to: {APP_BASE_URL}/api/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional overrides (defaults shown).
# PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Flutterwave (scaffold; optional) ----
# Dashboard -> Settings. Webhook secret is the "Secret hash" you set there;
# it arrives in the verif-hash header.
# Webhook URL: {APP_BASE_URL}/api/payments/webhook/flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Optional overrides (defaults shown).
# FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3