# Server
NODE_ENV=development
PORT=3000

# PostgreSQL — local Windows installs often trust 127.0.0.1 connections.
# If yours needs a password: postgres://postgres:YOUR_PASSWORD@localhost:5432/agbedepay
DATABASE_URL=postgres://postgres@localhost:5432/agbedepay

# OTP delivery provider: "mock" (prints the code to the server console) or
# "termii" (sends a real SMS). Defaults to "mock" when unset.
SMS_PROVIDER=termii

# Termii (https://termii.com) — only needed when SMS_PROVIDER=termii.
# Get your API key from Settings -> API token. Sender ID must be an approved
# alphanumeric sender ID (or your "Generic"/DND sender) on your account.
# Base URL is your per-account dashboard URL (v4 accounts use https://v4.api.termii.com).
TERMII_API_KEY=YOUR_TERMII_API_KEY
TERMII_SENDER_ID=YOUR_TERMII_SENDER_ID
TERMII_BASE_URL=https://v4.api.termii.com